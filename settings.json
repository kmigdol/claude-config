{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__save_issue",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/linear-title-check.py",
            "timeout": 10,
            "statusMessage": "Checking ticket title"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/linear-servers-reminder.sh",
            "timeout": 5,
            "statusMessage": "Linear server rule"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "i-have-adhd@i-have-adhd": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "light",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
