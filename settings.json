{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__save_issue",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/linear-title-check.py",
            "timeout": 10,
            "statusMessage": "Checking ticket title"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "light",
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true
}
